<script>
"use strict";

const $=id=>document.getElementById(id);
const chart=$("chart"),ctx=chart.getContext("2d");

const markets={
 Forex:{EURUSD:{p:1.10000,s:.00015,d:5,m:100000},GBPUSD:{p:1.27000,s:.00020,d:5,m:100000},USDJPY:{p:150.000,s:.020,d:3,m:1000}},
 Crypto:{BTCUSD:{p:65000,s:10,d:2,m:1},ETHUSD:{p:3500,s:1,d:2,m:1}},
 Gold:{XAUUSD:{p:2650,s:.30,d:2,m:100}},
 Indices:{US30:{p:42000,s:2,d:1,m:1},NAS100:{p:18500,s:1,d:1,m:1}},
 Stocks:{AAPL:{p:220,s:.03,d:2,m:1},TSLA:{p:300,s:.05,d:2,m:1}}
};

let market="Forex",symbol="EURUSD",base=1.1,spread=.00015,digits=5,multiplier=100000;
let candles=[],index=99,timer=null,positions=[],history=[];
let balance=10000,closedPL=0,wins=0,closed=0;
let show20=true,show50=true,showRSI=true;
let lastTick=0;

function round(n){return Number(n.toFixed(digits))}
function quote(){
 const close=candles[index]?.close??base;
 return {bid:round(close-spread/2),ask:round(close+spread/2),last:round(close)};
}
function format(n){return Number(n).toFixed(digits)}
function money(n){return (n<0?"-$":"$")+Math.abs(n).toFixed(2)}
function generate(){
 candles=[];
 let p=base;
 for(let i=0;i<100;i++){
  let o=p,c=o+(Math.random()-.49)*base*.0015;
  candles.push({open:o,close:c,high:Math.max(o,c)+Math.random()*base*.0005,low:Math.min(o,c)-Math.random()*base*.0005});
  p=c;
 }
 index=99;
}
function ema(period){
 let values=[],k=2/(period+1),e=candles[0]?.close??base;
 candles.forEach((c,i)=>{e=i===0?c.close:c.close*k+e*(1-k);values.push(e)});
 return values;
}
function rsi(){
 let start=Math.max(1,index-13),g=0,l=0,n=0;
 for(let i=start;i<=index;i++){
  let d=candles[i].close-candles[i-1].close;
  if(d>0)g+=d;else l-=d;n++;
 }
 if(!n)return 50;
 if(!l)return 100;
 return 100-100/(1+(g/n)/(l/n));
}
function resize(){
 let w=chart.clientWidth||320,h=340,d=window.devicePixelRatio||1;
 chart.width=w*d;chart.height=h*d;
 ctx.setTransform(d,0,0,d,0,0);draw();
}
function draw(){
 const w=chart.clientWidth||320,h=340;
 ctx.clearRect(0,0,w,h);
 const visible=candles.slice(0,index+1);
 if(!visible.length)return;
 let lo=Math.min(...visible.map(c=>c.low)),hi=Math.max(...visible.map(c=>c.high));
 positions.forEach(p=>{lo=Math.min(lo,p.entry,p.sl||lo,p.tp||lo);hi=Math.max(hi,p.entry,p.sl||hi,p.tp||hi)});
 let pad=(hi-lo)*.1||base*.001;lo-=pad;hi+=pad;
 const y=p=>h-22-(p-lo)/(hi-lo)*(h-44);
 const gap=w/Math.max(visible.length,1);
 ctx.strokeStyle="#203149";ctx.lineWidth=1;
 for(let j=0;j<5;j++){let yy=20+j*(h-40)/4;ctx.beginPath();ctx.moveTo(0,yy);ctx.lineTo(w,yy);ctx.stroke()}
 visible.forEach((c,i)=>{
  let x=i*gap+gap/2,up=c.close>=c.open;
  ctx.strokeStyle=up?"#22c55e":"#ef4444";ctx.fillStyle=ctx.strokeStyle;
  ctx.beginPath();ctx.moveTo(x,y(c.high));ctx.lineTo(x,y(c.low));ctx.stroke();
  ctx.fillRect(x-gap*.3,Math.min(y(c.open),y(c.close)),Math.max(2,gap*.6),Math.max(2,Math.abs(y(c.open)-y(c.close))));
 });
 function line(values,color){
  ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.beginPath();
  values.slice(0,index+1).forEach((v,i)=>{let x=i*gap+gap/2;if(i===0)ctx.moveTo(x,y(v));else ctx.lineTo(x,y(v))});
  ctx.stroke();
 }
 if(show20)line(ema(20),"#fbbf24");
 if(show50)line(ema(50),"#38bdf8");
 const q=quote();
 function horizontal(price,color,label,dash){
  if(!price)return;
  ctx.strokeStyle=color;ctx.setLineDash(dash?[5,4]:[]);
  ctx.beginPath();ctx.moveTo(0,y(price));ctx.lineTo(w,y(price));ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle=color;ctx.fillText(label+" "+format(price),6,Math.max(12,y(price)-5));
 }
 horizontal(q.last,"#e2e8f0","PRICE",true);
 positions.forEach(p=>{
  horizontal(p.entry,p.side==="BUY"?"#22c55e":"#f87171",p.side+" ENTRY",false);
  horizontal(p.sl,"#ef4444","STOP LOSS",true);
  horizontal(p.tp,"#22c55e","TAKE PROFIT",true);
 });
 ctx.fillStyle="#94a3b8";ctx.font="11px Arial";
 ctx.fillText("SIMULATED "+symbol,8,14);
 updateUI();
}
function pnl(p){
 const q=quote(),exit=p.side==="BUY"?q.bid:q.ask;
 return (p.side==="BUY"?exit-p.entry:p.entry-exit)*p.size*multiplier;
}
function updateQuotes(){
 const q=quote();
 $("bid").textContent=format(q.bid);
 $("ask").textContent=format(q.ask);
 $("last").textContent=format(q.last);
 $("spread").textContent=(spread/(base===0?1:base)* (market==="Forex"&&symbol!=="USDJPY"?10000:1)).toFixed(2)+(market==="Forex"?" pips":"");
 $("chartTitle").textContent=symbol+" — "+$("timeframe").value+" — SIMULATION";
 $("chartInfo").textContent="Candle "+(index+1)+" / "+candles.length+" | Last: "+format(q.last);
 $("rsiValue").textContent=showRSI?"RSI (14): "+rsi().toFixed(1):"RSI hidden";
}
function updateUI(){
 updateQuotes();
 let float=positions.reduce((s,p)=>s+pnl(p),0);
 $("balance").textContent=money(balance);
 $("equity").textContent=money(balance+float);
 $("floating").textContent=money(float);
 $("closedPL").textContent=money(closedPL);
 $("winrate").textContent=(closed?wins/closed*100:0).toFixed(1)+"%";
 $("tradecount").textContent=closed;
 $("floating").className=float>=0?"positive":"negative";
 $("positions").innerHTML=positions.length?positions.map(p=>{
  let v=pnl(p);
  return `<tr><td>${p.symbol}</td><td>${p.side}</td><td>${p.size}</td><td>${format(p.entry)}</td><td>${p.sl?format(p.sl):"—"}</td><td>${p.tp?format(p.tp):"—"}</td><td class="${v>=0?"positive":"negative"}">${money(v)}</td><td><button class="close" onclick="closePosition(${p.id})">Close</button></td></tr>`;
 }).join(""):'<tr><td colspan="8">No open positions</td></tr>';
 $("history").innerHTML=history.length?history.slice().reverse().map(t=>
 `<tr><td>${t.symbol}</td><td>${t.side}</td><td>${format(t.entry)}</td><td>${format(t.exit)}</td><td class="${t.pnl>=0?"positive":"negative"}">${money(t.pnl)}</td><td>${t.reason}</td></tr>`
 ).join(""):'<tr><td colspan="6">No closed trades</td></tr>';
}
function execute(side){
 const size=Number($("size").value),q=quote();
 if(!Number.isFinite(size)||size<=0){alert("Enter a valid position size.");return}
 const slText=$("sl").value,tpText=$("tp").value;
 const sl=slText===""?null:Number(slText),tp=tpText===""?null:Number(tpText);
 if((sl!==null&&!Number.isFinite(sl))||(tp!==null&&!Number.isFinite(tp))){alert("Check your Stop Loss and Take Profit prices.");return}
 const entry=side==="BUY"?q.ask:q.bid;
 if(sl!==null&&((side==="BUY"&&sl>=entry)||(side==="SELL"&&sl<=entry))){alert("Stop Loss must be below entry for BUY and above entry for SELL.");return}
 if(tp!==null&&((side==="BUY"&&tp<=entry)||(side==="SELL"&&tp>=entry))){alert("Take Profit must be above entry for BUY and below entry for SELL.");return}
 positions.push({id:Date.now()+Math.random(),symbol,side,size,entry,sl,tp,multiplier});
 $("status").textContent=side+" position opened on "+symbol+" at "+format(entry);
 draw();
}
function closePosition(id,reason="MANUAL"){
 let i=positions.findIndex(p=>p.id===id);if(i<0)return;
 const p=positions[i],q=quote(),exit=p.side==="BUY"?q.bid:q.ask;
 const result=(p.side==="BUY"?exit-p.entry:p.entry-exit)*p.size*p.multiplier;
 balance+=result;closedPL+=result;closed++;if(result>0)wins++;
 history.push({...p,exit,pnl:result,reason});
 positions.splice(i,1);
 $("status").textContent=p.symbol+" "+p.side+" closed: "+money(result)+" ("+reason+")";
 draw();
}
function checkStops(){
 const q=quote();
 positions.slice().forEach(p=>{
  let hit=null;
  if(p.side==="BUY"&&p.sl!==null&&q.bid<=p.sl)hit="STOP LOSS";
  if(p.side==="BUY"&&p.tp!==null&&q.bid>=p.tp)hit="TAKE PROFIT";
  if(p.side==="SELL"&&p.sl!==null&&q.ask>=p.sl)hit="STOP LOSS";
  if(p.side==="SELL"&&p.tp!==null&&q.ask<=p.tp)hit="TAKE PROFIT";
  if(hit)closePosition(p.id,hit);
 });
}
function tick(){
 let old=candles[index].close;
 let move=(Math.random()-.5)*base*.00025;
 let c=Math.max(base*.01,old+move);
 candles[index].close=c;
 candles[index].high=Math.max(candles[index].high,c);
 candles[index].low=Math.min(candles[index].low,c);
 lastTick++;
 if(lastTick>=5){
  lastTick=0;
  let o=c;
  candles.push({open:o,close:o,high:o,low:o});
  index++;
  if(candles.length>150){candles.shift();index--}
 }
 checkStops();draw();
}
function pause(){clearInterval(timer);timer=null}
function play(){if(timer)return;timer=setInterval(tick,Number($("speed").value))}
function resetSimulation(){
 pause();generate();positions=[];history=[];balance=10000;closedPL=0;wins=0;closed=0;
 $("progress").value=99;$("sl").value="";$("tp").value="";
 $("status").textContent="New "+symbol+" simulation started.";
 draw();
}
function selectMarket(){
 market=$("market").value;
 let first=Object.keys(markets[market])[0];
 $("symbol").innerHTML=Object.keys(markets[market]).map(s=>`<option>${s}</option>`).join("");
 $("symbol").value=first;selectSymbol();
}
function selectSymbol(){
 symbol=$("symbol").value;
 let item=markets[market][symbol];
 base=item.p;spread=item.s;digits=item.d;multiplier=item.m;
 resetSimulation();
}
$("market").addEventListener("change",selectMarket);
$("symbol").addEventListener("change",selectSymbol);
$("timeframe").addEventListener("change",draw);
$("buy").addEventListener("click",()=>execute("BUY"));
$("sell").addEventListener("click",()=>execute("SELL"));
$("reset").addEventListener("click",resetSimulation);
$("resetAccount").addEventListener("click",()=>{
 if(!confirm("Reset account balance and all trade records?"))return;
 balance=10000;closedPL=0;wins=0;closed=0;positions=[];history=[];draw();
});
$("play").addEventListener("click",play);
$("pause").addEventListener("click",pause);
$("next").addEventListener("click",()=>{pause();tick()});
$("previous").addEventListener("click",()=>{
 pause();if(index>0){index--;candles=candles.slice(0,index+1);draw()}
});
$("progress").addEventListener("input",e=>{
 pause();let target=Number(e.target.value);
 index=Math.max(0,Math.min(candles.length-1,target));draw();
});
$("ema20").addEventListener("click",()=>{show20=!show20;$("ema20").classList.toggle("active",show20);$("ema20").textContent="EMA 20: "+(show20?"ON":"OFF");draw()});
$("ema50").addEventListener("click",()=>{show50=!show50;$("ema50").classList.toggle("active",show50);$("ema50").textContent="EMA 50: "+(show50?"ON":"OFF");draw()});
$("rsiToggle").addEventListener("click",()=>{showRSI=!showRSI;$("rsiToggle").classList.toggle("active",showRSI);$("rsiToggle").textContent="RSI: "+(showRSI?"ON":"OFF");draw()});
$("speed").addEventListener("change",()=>{if(timer){pause();play()}});
window.addEventListener("resize",resize);

// ===== TRADELAB AI v2.1: HISTORICAL CSV ENGINE =====

let historicalCandles = [];
let historicalPosition = 0;
let historicalTimer = null;

function parseCSVLine(line) {
  const values = [];
  let current = "";
  let quoted = false;

  for (let i = 0; i < line.length; i++) {
    const char = line[i];

    if (char === '"') {
      if (quoted && line[i + 1] === '"') {
        current += '"';
        i++;
      } else {
        quoted = !quoted;
      }
    } else if (char === "," && !quoted) {
      values.push(current.trim());
      current = "";
    } else {
      current += char;
    }
  }

  values.push(current.trim());
  return values;
}

function stopHistoricalReplay() {
  if (historicalTimer) {
    clearInterval(historicalTimer);
    historicalTimer = null;
  }
}

function updateHistoricalProgress() {
  const progress = document.getElementById("historicalProgress");

  if (!historicalCandles.length) {
    progress.textContent = "Historical replay not started.";
    return;
  }

  progress.textContent =
    "Candle " + (historicalPosition + 1) +
    " of " + historicalCandles.length +
    " | Time: " +
    historicalCandles[historicalPosition].time;
}

document.getElementById("loadCSV").addEventListener("click", function () {
  const fileInput = document.getElementById("csvFile");
  const status = document.getElementById("csvStatus");
  const file = fileInput.files[0];

  if (!file) {
    status.textContent = "Please select a CSV file first.";
    return;
  }

  const reader = new FileReader();

  reader.onload = function (event) {
    try {
      const lines = event.target.result
        .replace(/^\uFEFF/, "")
        .split(/\r?\n/)
        .filter(line => line.trim() !== "");

      if (lines.length < 2) {
        throw new Error("The CSV file has no candle data.");
      }

      const headers = parseCSVLine(lines[0])
        .map(header => header.toLowerCase().trim());

      const timeIndex = headers.findIndex(
        h => ["time", "date", "timestamp", "datetime"].includes(h)
      );

      const openIndex = headers.indexOf("open");
      const highIndex = headers.indexOf("high");
      const lowIndex = headers.indexOf("low");
      const closeIndex = headers.indexOf("close");

      if ([timeIndex, openIndex, highIndex, lowIndex, closeIndex].includes(-1)) {
        throw new Error(
          "Required columns: time, open, high, low, close."
        );
      }

      const imported = [];

      for (let i = 1; i < lines.length; i++) {
        const values = parseCSVLine(lines[i]);

        const candle = {
          time: values[timeIndex],
          open: Number(values[openIndex]),
          high: Number(values[highIndex]),
          low: Number(values[lowIndex]),
          close: Number(values[closeIndex]),
          volume: headers.includes("volume")
            ? Number(values[headers.indexOf("volume")]) || 0
            : 0
        };

        if (
          !candle.time ||
          !Number.isFinite(candle.open) ||
          !Number.isFinite(candle.high) ||
          !Number.isFinite(candle.low) ||
          !Number.isFinite(candle.close) ||
          candle.open <= 0 ||
          candle.high <= 0 ||
          candle.low <= 0 ||
          candle.close <= 0 ||
          candle.high < Math.max(candle.open, candle.close, candle.low) ||
          candle.low > Math.min(candle.open, candle.close, candle.high)
        ) {
          throw new Error("Invalid candle data on CSV row " + (i + 1) + ".");
        }

        imported.push(candle);
      }

      if (!imported.length) {
        throw new Error("No valid historical candles were found.");
      }

      stopHistoricalReplay();
      historicalCandles = imported;
      historicalPosition = 0;

      status.textContent =
        "Successfully loaded " + imported.length +
        " historical candles.";

      updateHistoricalProgress();

    } catch (error) {
      status.textContent = "Import failed: " + error.message;
    }
  };

  reader.onerror = function () {
    status.textContent = "Unable to read this file.";
  };

  reader.readAsText(file);
});

document.getElementById("historicalPlay").addEventListener("click", function () {
  if (!historicalCandles.length) {
    document.getElementById("csvStatus").textContent =
      "Upload historical CSV data first.";
    return;
  }

  if (historicalPosition >= historicalCandles.length - 1) {
    historicalPosition = 0;
  }

  stopHistoricalReplay();

  const speed = Number(
    document.getElementById("historicalSpeed").value
  );

  historicalTimer = setInterval(function () {
    if (historicalPosition < historicalCandles.length - 1) {
      historicalPosition++;
      updateHistoricalProgress();
    } else {
      stopHistoricalReplay();
      document.getElementById("csvStatus").textContent =
        "Historical replay completed.";
    }
  }, speed);

  document.getElementById("csvStatus").textContent =
    "Historical replay is running.";
});

document.getElementById("historicalPause").addEventListener("click", function () {
  stopHistoricalReplay();

  document.getElementById("csvStatus").textContent =
    "Historical replay paused.";
});

document.getElementById("historicalNext").addEventListener("click", function () {
  stopHistoricalReplay();

  if (!historicalCandles.length) {
    document.getElementById("csvStatus").textContent =
      "Upload historical CSV data first.";
    return;
  }

  if (historicalPosition < historicalCandles.length - 1) {
    historicalPosition++;
    updateHistoricalProgress();
  } else {
    document.getElementById("csvStatus").textContent =
      "You have reached the final candle.";
  }
});

document.getElementById("clearCSV").addEventListener("click", function () {
  stopHistoricalReplay();

  historicalCandles = [];
  historicalPosition = 0;

  document.getElementById("csvFile").value = "";
  document.getElementById("csvStatus").textContent =
    "Historical data cleared.";

  document.getElementById("historicalProgress").textContent =
    "Historical replay not started.";
});

// ===== END HISTORICAL CSV ENGINE =====
   
generate();resize();draw();
