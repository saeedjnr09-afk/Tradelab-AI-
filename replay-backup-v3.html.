
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#080d18">
<title>TRADELAB AI | Trading Terminal v2.0</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d18;color:#e5e7eb;font-family:Arial,sans-serif;font-size:14px}
header{background:#101a2b;padding:15px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:1px solid #26364d}
.brand{font-size:22px;font-weight:bold;color:#38bdf8}
.sub{color:#94a3b8;font-size:11px}
main{padding:12px;max-width:1500px;margin:auto}
.panel{background:#111c2e;border:1px solid #273750;border-radius:10px;padding:13px;margin-bottom:12px}
h3{font-size:15px;margin:0 0 12px}
select,input,button{background:#1b2a40;color:white;border:1px solid #394d68;padding:10px;border-radius:6px;font-size:13px;max-width:100%}
button{cursor:pointer}
button:active{opacity:.75}
button:disabled{opacity:.4}
.controls{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.quote{background:#0b1526;padding:13px;border-radius:8px;min-width:0}
.quote small,.metric small{color:#94a3b8;display:block;margin-bottom:7px}
.quote strong{font-size:19px;font-variant-numeric:tabular-nums}
.bid{color:#ef7777}.ask{color:#36d399}
.metric{background:#192941;padding:12px;border-radius:8px;min-width:0}
.metric strong{font-size:19px;display:block;margin-top:5px;overflow-wrap:anywhere}
.muted{color:#94a3b8}
.positive{color:#34d399!important}
.negative{color:#fb7185!important}
#chart{width:100%;height:340px;display:block;background:#091321;border-radius:7px}
.charttools{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px}
.charttools button.active{background:#2563eb}
table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:12px}
th,td{padding:10px 8px;text-align:left;border-bottom:1px solid #2b3c54}
th{color:#94a3b8}
.scroll{overflow-x:auto}
.buy{background:#087c59;border-color:#087c59;font-weight:bold}
.sell{background:#b83245;border-color:#b83245;font-weight:bold}
.close{background:#7c2d3b}
.full{width:100%}
input[type=number]{width:100%}
label{display:block;color:#94a3b8;font-size:12px;margin:9px 0 5px}
.notice{color:#fbbf24;font-size:11px;line-height:1.5}
.positionline{color:#38bdf8}
@media(min-width:850px){
 main{padding:18px}
 .layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:12px}
 .grid{grid-template-columns:repeat(4,minmax(0,1fr))}
}
</style>
</head>
<body>
<header>
 <div>
  <div class="brand">TRADELAB AI</div>
  <div class="sub">PROFESSIONAL TRADING TERMINAL v2.0</div>
 </div>
 <div><span class="positive">● SIMULATION</span></div>
</header>

<main>
 <section class="panel">
  <h3>Market Selection</h3>
